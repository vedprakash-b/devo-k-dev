# Copy to .env (never commit .env):  cp .env.example .env
# Every variable has the DEVOKDEV_ prefix. Defaults live in src/devokdev/config.py.

DEVOKDEV_ENV=dev
DEVOKDEV_LOG_LEVEL=INFO
DEVOKDEV_LOG_FORMAT=console

# --- PostgreSQL + pgvector (local only; ports are bound to 127.0.0.1)
DEVOKDEV_POSTGRES_HOST=127.0.0.1
DEVOKDEV_POSTGRES_PORT=5432
DEVOKDEV_POSTGRES_USER=devokdev
DEVOKDEV_POSTGRES_PASSWORD=change-me-local-only
DEVOKDEV_POSTGRES_DB=devokdev

# --- Redis
DEVOKDEV_REDIS_PORT=6379
DEVOKDEV_REDIS_URL=redis://127.0.0.1:6379/0

# --- Temporal
DEVOKDEV_TEMPORAL_ADDRESS=127.0.0.1:7233
DEVOKDEV_TEMPORAL_NAMESPACE=default
DEVOKDEV_TEMPORAL_TASK_QUEUE=devokdev-default
DEVOKDEV_TEMPORAL_UI_URL=http://127.0.0.1:8233

# --- Free model providers. One key is enough to start; see docs/learning/M1.md.
# Paste keys here only, never into a chat or a commit.
DEVOKDEV_GROQ_API_KEY=
DEVOKDEV_CEREBRAS_API_KEY=
DEVOKDEV_OPENROUTER_API_KEY=
DEVOKDEV_GOOGLE_API_KEY=
DEVOKDEV_MISTRAL_API_KEY=
DEVOKDEV_CLOUDFLARE_API_TOKEN=
DEVOKDEV_CLOUDFLARE_ACCOUNT_ID=
DEVOKDEV_NVIDIA_API_KEY=

# --- Router (optional; these are the defaults)
# DEVOKDEV_MODELS_FILE=config/models.yaml
# DEVOKDEV_DATA_DIR=.devokdev
# DEVOKDEV_ROUTER_FIRST_TOKEN_TIMEOUT_S=30
# DEVOKDEV_ROUTER_STALL_TIMEOUT_S=60
# DEVOKDEV_ROUTER_TOTAL_TIMEOUT_S=300
# DEVOKDEV_ROUTER_MAX_ATTEMPTS=6
# DEVOKDEV_ROUTER_BREAKER_FAILURES=3
# DEVOKDEV_ROUTER_BREAKER_COOLDOWN_S=60
# DEVOKDEV_ROUTER_SWITCH_BACK_AFTER_S=120
